{
  "name": "@juherr/mobilityid",
  "version": "0.0.0-development",
  "description": "TypeScript mobility ID domain model, validation, and parsers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juherr/mobilityid.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/juherr/mobilityid/tree/main/ts#readme",
  "bugs": {
    "url": "https://github.com/juherr/mobilityid/issues"
  },
  "keywords": [
    "mobility",
    "ev",
    "evse",
    "contract-id",
    "emaid",
    "iso-15118",
    "din-91286",
    "ocpi"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "build": "vp pack",
    "generate:iso3166": "scripts/generate-iso3166.sh",
    "lint": "vp lint src test",
    "lint:fix": "vp lint --fix src test",
    "check:headers": "scripts/tests/header-policy.test.sh",
    "format": "vp fmt . --write",
    "format:check": "vp fmt --check",
    "typecheck": "vp check",
    "test": "vp test --coverage",
    "check:shape": "publint --strict && attw --pack . --profile esm-only",
    "check": "vp check && vp test --coverage && vp pack && bun run check:shape",
    "check:package": "scripts/verify-package.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@tony.ganchev/eslint-plugin-header": "3.4.4",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "^4.10.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vite-plus": "0.3.3"
  }
}
