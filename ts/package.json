{
  "name": "@juherr/mobilityid",
  "version": "0.0.0-development",
  "description": "TypeScript mobility ID domain model, validation, and parsers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juherr/mobilityid.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/juherr/mobilityid/tree/main/ts#readme",
  "bugs": {
    "url": "https://github.com/juherr/mobilityid/issues"
  },
  "keywords": [
    "mobility",
    "ev",
    "evse",
    "contract-id",
    "emaid",
    "iso-15118",
    "din-91286",
    "ocpi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint src test",
    "lint:fix": "vp lint --fix src test",
    "check:headers": "scripts/tests/header-policy.test.sh",
    "format": "vp fmt . --write",
    "format:check": "vp fmt --check",
    "typecheck": "vp check",
    "test": "vp test",
    "check": "vp check && vp test && vp pack"
  },
  "devDependencies": {
    "@tony.ganchev/eslint-plugin-header": "^3.4.3",
    "@types/node": "^24.0.0",
    "publint": "0.3.24",
    "vite-plus": "^0.1.16"
  }
}
